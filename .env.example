# Copy to /etc/jobsapp/jobsapp.env on the server (see DEPLOY.md).
# Nothing here is needed to run the app locally with `runserver`.
#
# Format rules (systemd reads this file):
#   - one KEY=value per line, NO spaces around "="
#   - comments only on their own line: a "# ..." after a value becomes part of the value

# --- core ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=jobs.lab.local,10.10.20.10

# --- where data lives on the server (outside the code folder) ---
DJANGO_DB_PATH=/var/lib/jobsapp/db.sqlite3
DJANGO_STATIC_ROOT=/srv/jobsapp/staticfiles
# security.log is written here
DJANGO_LOG_DIR=/var/log/jobsapp

# --- accounts ---
# 0 = only admins create accounts
DJANGO_ALLOW_SIGNUP=1
# failed logins before lockout, and lockout duration in minutes
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- behind Nginx / HTTPS ---
# trust X-Forwarded-For / -Proto sent by Nginx
DJANGO_BEHIND_PROXY=1
# secure cookies + redirect http -> https
DJANGO_HTTPS=1
# keep 0 with a self-signed certificate; raise (e.g. 3600) only once HTTPS is confirmed working
DJANGO_HSTS_SECONDS=0
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobs.lab.local

# --- scraper: contact URL or e-mail shown in the bot's User-Agent ---
SCRAPER_CONTACT=https://github.com/Solaire006/StageL2

# --- email (password reset). Without these, mails are printed to the app log. ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.lab.local
EMAIL_PORT=25
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@jobs.lab.local
