# Copy to .env and export these before starting the server (or put them in the
# systemd unit's EnvironmentFile). None are required for local development.

# --- core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=jobs.lab.local,10.10.20.10

# --- accounts ---
DJANGO_ALLOW_SIGNUP=1          # 0 = only admins create accounts
AXES_FAILURE_LIMIT=5           # failed logins before lockout
AXES_COOLOFF_MINUTES=15        # lockout duration

# --- behind Nginx / HTTPS ---
DJANGO_BEHIND_PROXY=1          # trust X-Forwarded-For / -Proto from Nginx
DJANGO_HTTPS=1                 # secure cookies
DJANGO_HSTS_SECONDS=0          # raise once HTTPS is confirmed working
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobs.lab.local

# --- logs ---
DJANGO_LOG_DIR=/var/log/jobsapp   # security.log is written here

# --- email (password reset). Default prints mails to the console. ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.lab.local
EMAIL_PORT=25
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@jobs.lab.local
